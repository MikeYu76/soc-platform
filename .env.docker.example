# Copy this file to .env and replace every placeholder before starting Docker.
SOC_JWT_SECRET=replace_with_a_random_64_character_secret
SOC_ACCESS_TOKEN_EXPIRE_MINUTES=30
SOC_BOOTSTRAP_ADMIN_USERNAME=admin
SOC_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_characters
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace_with_a_different_strong_password
